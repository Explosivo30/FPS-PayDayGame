    public static class EZCollabLocalization
    {
        const string PreferenceKey = "EZCollabTool.Language";
        const string EnglishCode = "en";
        const string SpanishCode = "es";

        static readonly object gate = new object();
        static readonly Dictionary<string, EZCollabLanguage> languages =
            new Dictionary<string, EZCollabLanguage>(StringComparer.OrdinalIgnoreCase);
        static readonly List<string> languageOrder = new List<string>();
        static string currentLanguageCode;

        public static event Action languageChanged;

        static EZCollabLocalization()
        {
            RegisterBuiltInLanguages();

            string savedCode = EditorPrefs.GetString(PreferenceKey, EnglishCode);
            currentLanguageCode = languages.ContainsKey(savedCode) ? savedCode : EnglishCode;
        }

        public static string currentCode => currentLanguageCode;

        public static IReadOnlyList<EZCollabLanguage> GetLanguages()
        {
            lock (gate)
            {
                List<EZCollabLanguage> result = new List<EZCollabLanguage>(languageOrder.Count);
                foreach (string code in languageOrder)
                {
                    if (languages.TryGetValue(code, out EZCollabLanguage language))
                        result.Add(language);
                }
                return result;
            }
        }

        public static bool SetLanguage(string code)
        {
            if (string.IsNullOrWhiteSpace(code))
                return false;

            lock (gate)
            {
                if (!languages.ContainsKey(code))
                    return false;
                if (string.Equals(currentLanguageCode, code, StringComparison.OrdinalIgnoreCase))
                    return true;

                currentLanguageCode = code;
                EditorPrefs.SetString(PreferenceKey, code);
            }

            languageChanged?.Invoke();
            return true;
        }

        public static bool RegisterLanguage(
            string code,
            string displayName,
            IDictionary<string, string> translations,
            bool replaceExisting = false)
        {
            if (string.IsNullOrWhiteSpace(code) || string.IsNullOrWhiteSpace(displayName) ||
                translations == null)
            {
                return false;
            }

            lock (gate)
            {
                if (languages.ContainsKey(code) && !replaceExisting)
                    return false;

                if (!languages.ContainsKey(code))
                    languageOrder.Add(code);
                languages[code] = new EZCollabLanguage(code, displayName, translations);
            }

            languageChanged?.Invoke();
            return true;
        }

        public static string Tr(string key, params object[] arguments)
        {
            string template = null;
            lock (gate)
            {
                if (languages.TryGetValue(currentLanguageCode, out EZCollabLanguage current))
                    current.TryGet(key, out template);

                if (string.IsNullOrEmpty(template) &&
                    languages.TryGetValue(EnglishCode, out EZCollabLanguage english))
                {
                    english.TryGet(key, out template);
                }
            }

            if (string.IsNullOrEmpty(template))
                template = key;
            if (arguments == null || arguments.Length == 0)
                return template;

            try
            {
                return string.Format(CultureInfo.CurrentCulture, template, arguments);
            }
            catch (FormatException)
            {
                return template;
            }
        }

        static void RegisterBuiltInLanguages()
        {
            RegisterLanguage(SpanishCode, "Español", CreateSpanishTranslations());
            RegisterLanguage(EnglishCode, "English", CreateEnglishTranslations());
        }

