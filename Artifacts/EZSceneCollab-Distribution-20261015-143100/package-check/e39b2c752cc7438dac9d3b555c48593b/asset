    public sealed class EZCollabLanguage
    {
        readonly Dictionary<string, string> translations;

        public string code { get; }
        public string displayName { get; }

        internal EZCollabLanguage(string code, string displayName, IDictionary<string, string> translations)
        {
            this.code = code;
            this.displayName = displayName;
            this.translations = new Dictionary<string, string>(translations, StringComparer.Ordinal);
        }

        internal bool TryGet(string key, out string value)
        {
            return translations.TryGetValue(key, out value);
        }
    }

